# Local development: no account or paid services required.
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/cloudvault.db
STORAGE_BACKEND=local
MAX_UPLOAD_MB=25
STORAGE_QUOTA_MB=500
COOKIE_SECURE=false
# PUBLIC_BASE_URL=http://localhost:8000

# Optional: persistent cloud deployment (requires your own storage/database accounts):
# STORAGE_BACKEND=s3
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# S3_BUCKET=your-bucket
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=auto
# COOKIE_SECURE=true
# PUBLIC_BASE_URL=https://your-service.onrender.com
